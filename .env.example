# Copy to .env.local and fill in. Names only; never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EVO_PASSCODE_EDITOR=
EVO_PASSCODE_VIEWER=
# Secret token in the calendar-feed URL (Vercel env)
CALENDAR_FEED_TOKEN=
# Optional: holiday import
CALENDARIFIC_API_KEY=
# Server-only HMAC secret for signed login sessions (>= 32 chars; never NEXT_PUBLIC).
# Generate with: openssl rand -base64 32. Login fails closed if missing/short.
EVO_SESSION_SECRET=
